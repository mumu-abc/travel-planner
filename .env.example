# LLM 配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
LLM_TEMPERATURE=0.7

# Agent 执行策略
# multi | sequential | single
# 默认 single（消融实测质量打平、更快更省）；multi 为深度档
PIPELINE_MODE=single
ENABLE_REFLECTION=true
MAX_TOOL_ROUNDS=3
PARALLEL_STAGGER_SEC=1.5

# 工具层 TTL 缓存（重复规划同一目的地时复用结果）
# 静态检索/路线/预算 24h；天气 30min、汇率与网络搜索 1h；只缓存成功结果
ENABLE_TOOL_CACHE=true
TOOL_CACHE_MAX_SIZE=512
MAX_WEB_SEARCH_CALLS=2

# 并发控制
RATE_LIMIT_RPS=10.0
RATE_LIMIT_CONCURRENT=5
RATE_LIMIT_RETRIES=3

# LangSmith 可观测性（可选，配置后自动开启 trace）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-planner
LANGSMITH_TRACING=false

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库路径（留空使用项目默认路径 data/travel.db）
TRAVEL_DB_PATH=data/travel.db
