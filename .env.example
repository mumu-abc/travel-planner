# LLM 配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.5-pro
LLM_TEMPERATURE=0.7
# 单次生成 token 上限。本模型是思维链模型（回答前先生成 reasoning_content），
# 4096 会被思考过程吃满导致正文为空（finish_reason=length / content 空），给足余量
# 单次生成的 token 安全天花板（思维链模型要留足思考空间，别压太小导致正文为空）
LLM_MAX_TOKENS=12288

# 工具调用阶段（只输出函数名+参数）的 token 额度，压小可降低该轮延迟
LLM_MAX_TOKENS_TOOL=2048

# 最终正文的目标字数上限；按 2.6 token/字 反推 max_tokens 硬上限。
# 实测模型会无视 prompt 里的字数要求写到 6000+ 字，而耗时≈字数×线性系数，
# 所以靠这个物理掐断来压缩生成时间。0 = 不限制。
MAX_OUTPUT_CHARS=3200

# Agent 执行策略
# multi | sequential | single
# 默认 single（消融实测质量打平、更快更省）；multi 为深度档
PIPELINE_MODE=single
ENABLE_REFLECTION=true
MAX_TOOL_ROUNDS=3
PARALLEL_STAGGER_SEC=1.5

# 工具层 TTL 缓存（重复规划同一目的地时复用结果）
# 静态检索/路线/预算 24h；天气 30min、汇率与网络搜索 1h；只缓存成功结果
ENABLE_TOOL_CACHE=true
TOOL_CACHE_MAX_SIZE=512
MAX_WEB_SEARCH_CALLS=2

# ── 联网搜索后端（可选，不配也能用）──────────────────────────
# 优先级：官方 API（配了 key 才启用）→ 必应中国 RSS（免密钥默认）→ 海外备用
#
# 为什么建议配官方 API：
#   必应中国 RSS 实测 0.4s 可用，但它是**未公开接口**（随时改版/限流），
#   属于临时方案；官方 API 有 SLA、合规、有账单可查，是正式方案。
#
# 三家实测（2026-09 无代理国内网络，全部 0.2~0.3s 可达）：
#   智谱   open.bigmodel.cn        ¥0.01/次
#   百度   qianfan.baidubce.com    1500 次/月免费
#   博查   api.bochaai.com         面向 AI 的搜索
#
# 填任意一个 key 即可自动启用，会自动排到必应前面。
# SEARCH_API_PROVIDER 留空 = 按 zhipu → baidu → bocha 顺序取第一个有 key 的。

SEARCH_API_PROVIDER=
ZHIPU_API_KEY=
BAIDU_SEARCH_API_KEY=
BOCHA_API_KEY=
SEARCH_API_TIMEOUT=10

# 并发控制
RATE_LIMIT_RPS=10.0
RATE_LIMIT_CONCURRENT=5
RATE_LIMIT_RETRIES=3

# LangSmith 可观测性（可选，配置后自动开启 trace）
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-planner
LANGSMITH_TRACING=false

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库路径（留空使用项目默认路径 data/travel.db）
TRAVEL_DB_PATH=data/travel.db
